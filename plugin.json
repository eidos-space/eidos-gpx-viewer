{
  "apiVersion": 1,
  "id": "eidos.gpx-viewer",
  "name": "GPX Viewer",
  "version": "0.1.4",
  "requires": {
    "pluginApi": "3.0.0"
  },
  "views": [
    {
      "id": "map",
      "title": "GPX 地图",
      "entry": "./src/main.ts",
      "kind": "file",
      "access": "read"
    }
  ],
  "placements": [
    {
      "location": "file/open",
      "view": "map",
      "extensions": [
        ".gpx"
      ]
    }
  ],
  "browser": {
    "workers": true,
    "networkOrigins": [
      "https://tiles.openfreemap.org"
    ]
  }
}
