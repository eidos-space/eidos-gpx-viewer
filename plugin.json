{
  "apiVersion": 1,
  "id": "eidos.gpx-viewer",
  "name": "%plugin.name%",
  "version": "0.2.0",
  "requires": {
    "pluginApi": "3.7.0"
  },
  "views": [
    {
      "id": "map",
      "title": "%views.map.title%",
      "entry": "./src/main.ts",
      "kind": "file",
      "access": "read"
    }
  ],
  "placements": [
    {
      "location": "file/open",
      "view": "map",
      "extensions": [
        ".gpx"
      ]
    }
  ],
  "browser": {
    "workers": true,
    "networkOrigins": [
      "https://tiles.openfreemap.org"
    ]
  },
  "description": "%plugin.description%",
  "i18n": {
    "defaultLocale": "en",
    "messages": {
      "en": "./locales/en.json",
      "zh-CN": "./locales/zh-CN.json"
    },
    "readme": {
      "en": "./README.md",
      "zh-CN": "./README.zh-CN.md"
    }
  }
}
